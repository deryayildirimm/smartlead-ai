# Prefer: python scripts/init_local_env.py
# Replace BOTH password placeholders with the same random value.
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=passageport
POSTGRES_USER=passageport
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://passageport:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@127.0.0.1:5433/passageport
# Production only: DJANGO_SETTINGS_MODULE=passageport.settings.production
# DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.example.com
# DJANGO_TRUST_PROXY=true  (only with a correctly configured trusted reverse proxy)
